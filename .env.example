# ---------------------------------------------------------------------------
# SurfaceWatch — docker compose configuration
#
#   cp .env.example .env
#   # then set POSTGRES_PASSWORD and JWT_SECRET; everything else has a default
#   docker compose up
#
# This file configures the *compose stack*. backend/.env.example is a separate
# thing: it is for running the backend directly on the host, outside Docker,
# and points at localhost instead of the compose service names. Neither is read
# by the other — if you run both ways, you maintain both.
#
# Only variables that docker-compose.yml actually interpolates appear here.
# Anything not listed is fixed in the compose file because it describes the
# topology of the stack rather than a choice you make (see "Deliberately not
# configurable" at the bottom).
#
# Never commit .env.
# ---------------------------------------------------------------------------


# === Required ===============================================================
# Compose refuses to start without these two — they have no default, because a
# default password and a default signing key are the two settings you must
# never inherit silently.

# Postgres superuser password. Any value works locally; it is only reachable
# from the compose network and, if you keep the published port, from localhost.
POSTGRES_PASSWORD=change-me

# Signs every access and refresh token. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Changing it invalidates every issued token, which is the intended way to
# force a global sign-out. get_settings() refuses to boot if ENVIRONMENT is
# production and this still contains "change-me".
JWT_SECRET=change-me-to-a-long-random-string


# === Database ===============================================================
# The backend reads five discrete POSTGRES_* values and derives two URLs from
# them: postgresql+asyncpg:// for the API and postgresql+psycopg:// for Celery
# and Alembic. There is no DATABASE_URL setting — see the note at the bottom.

POSTGRES_DB=surfacewatch
POSTGRES_USER=surfacewatch

# Host-side published port only. The containers always reach Postgres on 5432
# inside the network; this is what `psql -h localhost -p ...` from your machine
# connects to. Change it if something else on your host already owns 5432.
POSTGRES_PORT=5432


# === Redis ==================================================================
# Host-side published port, same as above. The three Redis URLs the backend
# uses are fixed in the compose file — see the bottom of this file for why.
REDIS_PORT=6379


# === Auth ===================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# bcrypt work factor. 12 is roughly 250ms per hash on a modern core, which is
# the point. Lower it for a test run if login latency is in your way; do not
# ship below 12.
BCRYPT_ROUNDS=12


# === CORS ===================================================================
# Checked against the Origin header the browser sends, so this is the address
# you type in the address bar — not a compose service name. Comma-separated
# for more than one.
CORS_ORIGINS=http://localhost:3000


# === Scanning ===============================================================
# The safety rail. With this false, a worker refuses any target that does not
# resolve into a domain the organisation has verified — it is what stops a scan
# being pointed at infrastructure you have no authorisation to touch. Turn it
# on only against hosts you own or have written permission to test.
ALLOW_ARBITRARY_TARGETS=false

SCAN_MAX_CONCURRENCY=200
SCAN_CONNECT_TIMEOUT=2.0

# Per-host, not global. Above ~50 you are load-testing the target rather than
# scanning it, and you will start being throttled or blocked.
SCAN_RATE_LIMIT_PER_HOST=50


# === CVE enrichment =========================================================
# Optional, and free — request one at https://nvd.nist.gov/developers/request-an-api-key
# Without a key NVD allows ~5 requests / 30s; with one, ~50. Enrichment still
# works unkeyed, just slowly enough to notice on a scan with many findings.
NVD_API_KEY=


# === AI remediation =========================================================
# When a CVE finding is created, the worker sends that CVE plus the host's
# observed ports and fingerprinted stack to the Claude API and stores the
# specific fix steps in findings.remediation. With no key set, findings keep the
# standard NVD-derived advice and nothing is sent anywhere — the feature is off,
# not broken.
#
# Note the prefix. This is NOT ANTHROPIC_API_KEY, and that is deliberate:
# pydantic-settings matches env vars case-insensitively, ANTHROPIC_API_KEY is
# commonly already exported in a developer shell or CI runner for something
# unrelated (Claude Code exports it), and the failure mode is silent in the
# worst direction — the feature switching itself on and billing a key nobody
# meant to point at this app. AI_REMEDIATION_ cannot collide with anything.
#
# What leaves your network per enriched finding: the CVE id and NVD
# description, the affected product and version, and the hostname, IP, open
# ports and detected technologies of the one affected host. Nothing else — no
# banners beyond 120 characters, no credentials, no other assets.
AI_REMEDIATION_API_KEY=

# Set false to keep the key configured but stop making calls — useful for a
# scan you do not want to pay for, without editing the key out.
AI_REMEDIATION_ENABLED=true

# Sonnet, not Opus: this is a bounded grounding task over facts we supply, and
# it runs once per finding across scans that can produce hundreds.
AI_REMEDIATION_MODEL=claude-sonnet-5

# Hard cap per scan, worst-severity-first. A large estate can produce thousands
# of findings and an unbounded fan-out turns one scan into an unbounded bill.
# If the cap truncates the run, the criticals are what got the good advice.
AI_REMEDIATION_MAX_PER_SCAN=60

AI_REMEDIATION_TIMEOUT=45.0

# Advice for one CVE against one product version is the same everywhere, so it
# is cached on that rather than per finding — two hosts running the same stack
# cost one call. 604800 = 7 days.
AI_REMEDIATION_CACHE_TTL_SECONDS=604800


# === Slack alerts ===========================================================
# The webhook URL is NOT here. It is per-organisation, stored on the
# organisations row, and set through Settings → Slack alerting in the UI — it is
# a bearer credential for one customer's channel, so a shared env file is the
# wrong place for it. The API never returns it in full, only a redacted hint.
#
# These are the transport-level knobs that apply to every org's webhook.

SLACK_NOTIFICATIONS_ENABLED=true

# Only findings at or above this severity post to Slack, and only on the scan
# that first created them — a nightly re-scan re-detects yesterday's CVEs, and
# paging the channel again each night is how an alert channel becomes one
# nobody reads. Widening this past `high` is usually a mistake.
SLACK_MIN_SEVERITY=critical

SLACK_TIMEOUT_SECONDS=10.0


# === Celery =================================================================
CELERY_LOG_LEVEL=INFO

# Concurrent worker processes across all three queues (scans, enrich, reports).
CELERY_CONCURRENCY=4


# === Ports and URLs =========================================================
API_PORT=8000
FRONTEND_PORT=3000

# Where the browser sends its API calls. localhost, not http://api:8000 — this
# value is compiled into the JavaScript that runs on your machine, and your
# browser has no route into the compose network. If you change API_PORT above,
# change the port here too; they are not linked.
NEXT_PUBLIC_API_URL=http://localhost:8000


# === General ================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Deliberately not configurable here
#
# These are set directly in docker-compose.yml, and putting them in .env would
# mean a value you can edit that quietly does nothing or breaks the stack:
#
#   POSTGRES_HOST          Always `postgres` — the compose service name. Inside
#                          a container, `localhost` is that container.
#
#   REDIS_URL              redis://redis:6379/0 — scan log pub/sub. This is the
#                          channel the /ws/scan/{id} WebSocket subscribes to.
#   CELERY_BROKER_URL      redis://redis:6379/1 — the task queue.
#   CELERY_RESULT_BACKEND  redis://redis:6379/2 — task results.
#
#                          Three logical databases on one Redis, kept apart so
#                          that flushing a stuck queue cannot also wipe the scan
#                          output a user is watching stream.
#
#   REPORT_OUTPUT_DIR      /var/lib/surfacewatch/reports — a named volume shared
#                          by the API and the worker. The worker writes the PDF
#                          there and the API streams it back on download; point
#                          them at different paths and every download 410s.
#
#
# Three notes on values you may have seen in a stock ASM .env, and what this
# backend actually does with them:
#
#   DATABASE_URL     Not read. config.py builds its connection strings from the
#                    discrete POSTGRES_* values above, and the settings model is
#                    configured with extra="ignore" — so a DATABASE_URL line
#                    here is accepted without complaint and has no effect. That
#                    is the failure mode worth knowing about: you would edit it,
#                    see no error, and still be connecting to the old database.
#
#   REDIS_URL        Real, but on its own it is not enough. It addresses only
#                    the pub/sub database; Celery needs its broker and result
#                    backend set separately, and a bare redis://host:6379 with
#                    no /N index would put all three on database 0 together.
#
#   OPENAI_API_KEY   Not read by anything. The AI remediation feature in this
#                    codebase calls the Anthropic Messages API and is configured
#                    through the AI_REMEDIATION_* block above; no module imports
#                    openai. Setting a key here would cost you nothing and do
#                    nothing, so it is omitted rather than listed as if it
#                    worked.
#
#   ANTHROPIC_API_KEY
#                    Also not read — and the omission is load-bearing rather
#                    than an oversight. See the AI_REMEDIATION_API_KEY note
#                    above: binding the SDK's conventional name would let a key
#                    already exported in your shell silently enable a paid
#                    feature. Use AI_REMEDIATION_API_KEY.
#
#   SLACK_WEBHOOK_URL
#                    Not read. Webhooks are per-organisation and live in the
#                    database, set through the settings UI. A single URL here
#                    would post every tenant's critical findings into one
#                    channel, which in a multi-org deployment is a data leak.
# ---------------------------------------------------------------------------
