# ---------------------------------------------------------------------------
# SurfaceWatch backend configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Async driver is used by the API, sync driver by Celery workers + Alembic.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=surfacewatch
POSTGRES_USER=surfacewatch
POSTGRES_PASSWORD=change-me

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# --- Password policy ---------------------------------------------------------
# Offline checks (length, character classes, a breach-corpus list, keyboard and
# repetition patterns, similarity to the account's own email/org) always run.
# This adds an online check against Have I Been Pwned's range API, which sends
# only the first 5 characters of the password's SHA-1 and never the password
# itself. It fails open: if the API is slow or down, the offline checks stand
# on their own rather than taking registration down with it.
PASSWORD_HIBP_CHECK_ENABLED=false
PASSWORD_HIBP_TIMEOUT=3.0
# Appearances in the corpus before a password is refused. 1 is the strict
# reading; a small allowance absorbs the occasional strong passphrase that
# someone else also thought of.
PASSWORD_HIBP_MAX_APPEARANCES=1

# --- Security headers --------------------------------------------------------
# HSTS is emitted only when ENVIRONMENT=production — sending it from a
# localhost dev server pins http://localhost to HTTPS in the developer's
# browser for max-age, which then breaks every other local project on that
# origin and cannot be undone from the app.
HSTS_MAX_AGE=31536000

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Datastore host binding --------------------------------------------------
# Postgres and Redis publish to 127.0.0.1 only. Set these to 0.0.0.0 ONLY if a
# remote client genuinely needs them: Docker inserts its publish rules ahead of
# ufw/firewalld, so a 0.0.0.0 bind is reachable from the LAN even with the host
# firewall "on". Redis here has no password at all.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# --- Rate limiting -----------------------------------------------------------
# Ceilings on the authentication endpoints, per fixed window. Counters live in
# Redis; if Redis is unreachable the limiter fails open (an auth outage is a
# worse failure than an unthrottled window).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=10
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REFRESH_PER_IP=60
# Reverse proxies in front of the app whose X-Forwarded-For entries are
# trustworthy. MUST stay 0 when the app is directly exposed — otherwise a
# forged header gives every request its own rate-limit bucket. Set to 1 behind
# one load balancer, 2 behind an LB plus a CDN.
TRUSTED_PROXY_COUNT=0

# --- Scanning ---------------------------------------------------------------
# Hard safety rail: workers refuse to scan a host that does not resolve into
# the organisation's verified domain(s) unless ALLOW_ARBITRARY_TARGETS=true.
ALLOW_ARBITRARY_TARGETS=false
SCAN_MAX_CONCURRENCY=200
SCAN_CONNECT_TIMEOUT=2.0
SCAN_RATE_LIMIT_PER_HOST=50
HTTP_USER_AGENT=SurfaceWatch/1.0 (+https://surfacewatch.local/scanner)

# --- CVE enrichment ---------------------------------------------------------
# Optional. Without a key NVD allows ~5 req / 30s; with one, ~50 req / 30s.
NVD_API_KEY=
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0

# --- AI remediation ---------------------------------------------------------
# When set, CVE findings get fix steps generated from this host's observed
# ports and stack instead of the generic NVD advice. Unset = feature off, no
# calls made, standard remediation kept.
#
# NOT named ANTHROPIC_API_KEY on purpose: pydantic-settings matches env vars
# case-insensitively, that name is commonly already exported in a developer
# shell (Claude Code exports it), and the feature would switch itself on
# against a key nobody meant to point here.
AI_REMEDIATION_API_KEY=
AI_REMEDIATION_ENABLED=true
AI_REMEDIATION_MODEL=claude-sonnet-5
AI_REMEDIATION_MAX_TOKENS=1200
AI_REMEDIATION_TIMEOUT=45.0
# Hard cap per scan, worst severity first, so a truncated run still enriched
# the criticals. Unbounded fan-out on a large estate is an unbounded bill.
AI_REMEDIATION_MAX_PER_SCAN=60
# Keyed on CVE + product version, not on the finding: two hosts running the
# same stack cost one call. 604800 = 7 days.
AI_REMEDIATION_CACHE_TTL_SECONDS=604800

# --- Slack alerts -----------------------------------------------------------
# The webhook URL is per-organisation and lives on the organisations row, set
# through Settings → Slack alerting. It is a credential for one customer's
# channel, so it is deliberately not a process-wide setting.
SLACK_NOTIFICATIONS_ENABLED=true
SLACK_MIN_SEVERITY=critical
SLACK_TIMEOUT_SECONDS=10.0

# --- Reports ----------------------------------------------------------------
REPORT_OUTPUT_DIR=/var/lib/surfacewatch/reports
