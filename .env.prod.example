# SurfaceWatch — production environment.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# Then fill in every value marked REQUIRED below. This file holds the JWT
# signing key and the database password: never commit it, and never reuse the
# values from your development .env — a leaked laptop should not mint valid
# tokens against production.
#
# Used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- REQUIRED: identity ------------------------------------------------------

# The hostname the API is served on. Its A record must point at this VM before
# you start the stack, or Caddy cannot get a certificate.
API_DOMAIN=api.example.com

# Let's Encrypt sends certificate-expiry warnings here. A real address you read.
ACME_EMAIL=you@example.com

# Your Vercel URL — the browser's Origin, not the API's own address. No trailing
# slash. Preview deployments each get their own origin; add them comma-separated
# or previews will fail CORS:
#   CORS_ORIGINS=https://surfacewatch.vercel.app,https://surfacewatch-git-dev-you.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# --- REQUIRED: secrets -------------------------------------------------------

# Generate fresh, do not reuse your local value:
#   openssl rand -base64 64 | tr -d '\n'
# Anyone holding this can mint valid tokens for any account in any org.
JWT_SECRET=

# Generate:  openssl rand -base64 32 | tr -d '\n'
POSTGRES_PASSWORD=

# --- Sizing ------------------------------------------------------------------
#
# Defaults suit a 1–2 vCPU / 1 GB free-tier VM. Raise them on a bigger box.

API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=50
REDIS_MAXMEMORY=256mb

# Database connections, per process. The free-tier defaults below are sized for
# a small managed Postgres whose max_connections is often only 20-25, which is
# the constraint that actually bites: API_WORKERS x (DB_POOL_SIZE +
# DB_MAX_OVERFLOW) plus the workers must stay under it. With the values here
# that is 2 x 6 + 3 = 15.
#
# Symptom of getting this wrong is "FATAL: sorry, too many clients already" in
# the API log under load, not a slow response.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=1

# Recycle idle connections after 30 minutes. Managed Postgres, and any pooler
# in front of it (pgbouncer, RDS Proxy, Neon, Supabase), closes idle
# connections on its own schedule; recycling first means the pool owns the
# decision rather than discovering the server's.
DB_POOL_RECYCLE=1800

# Fail a request that waits this long for a connection, rather than letting it
# hang until the client gives up.
DB_POOL_TIMEOUT=30.0

# Scan aggressiveness. Lower than the development defaults deliberately: a
# shared-core VM cannot sustain 200 concurrent sockets, and that rate also
# resembles an attack closely enough to attract your provider's abuse team.
SCAN_MAX_CONCURRENCY=50
SCAN_CONNECT_TIMEOUT=3.0
SCAN_RATE_LIMIT_PER_HOST=20

# --- Policy ------------------------------------------------------------------

# false restricts scanning to domains verified against your organisation.
# Setting this true lets any user scan any host on the internet from your VM,
# under your name and your provider's terms of service. Leave it false.
ALLOW_ARBITRARY_TARGETS=false

# Caddy is the single proxy in front of the API. Only change this if you add
# another (e.g. Cloudflare in front of Caddy → 2). Too high and anyone can spoof
# X-Forwarded-For to bypass auth rate limiting; too low and every request
# appears to come from the proxy, throttling all users as one.
TRUSTED_PROXY_COUNT=1

# Checks new passwords against Have I Been Pwned via k-anonymity (the password
# is never sent). Off by default because it makes registration depend on a third
# party being up. Worth turning on for a public deployment.
PASSWORD_HIBP_CHECK_ENABLED=true

LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# --- Scheduled scans ---------------------------------------------------------
#
# Recurring scans are fired by the `beat` service in docker-compose.prod.yml.
# Without it running, the dispatcher never ticks and every schedule appears
# enabled while never actually firing.

# How many dispatches in a row may fail before a schedule disables itself and
# records why. These are broker failures — a scan that runs and finds nothing
# is a success.
SCHEDULE_MAX_CONSECUTIVE_FAILURES=5

# Weekly re-check of every verified domain's DNS challenge. Verification proves
# ownership at a moment; domains change hands, and a record that has since been
# removed is the signal that a claim is stale.
DOMAIN_REVERIFY_ENABLED=true

# Consecutive failed re-checks before a domain is revoked. 0 means never revoke
# automatically, which is the default and the safer setting: an outage at a DNS
# provider, a resolver failure on our side, and a domain that genuinely changed
# hands are indistinguishable from here, and the cost of guessing wrong is
# taking away a customer's ability to scan. Raise it only where an unverified
# domain left scannable is the larger risk.
DOMAIN_REVERIFY_FAILURE_THRESHOLD=0

# --- Retention ---------------------------------------------------------------
#
# 0 disables a sweep. Log lines are the highest-volume, lowest-value rows in the
# schema, so that one is on. The other two are off, and should stay off unless
# you have decided otherwise: findings cascade with their scan, so pruning scans
# deletes the security history this product exists to keep.
RETENTION_SCAN_LOG_DAYS=30
RETENTION_SCAN_DAYS=0
RETENTION_REPORT_DAYS=0

# --- Optional integrations ---------------------------------------------------

# Free from https://nvd.nist.gov/developers/request-an-api-key — without it CVE
# lookups are rate limited to 5 requests per 30 seconds, which makes enrichment
# on a large scan take hours.
NVD_API_KEY=

# AI remediation guidance. With no key set, findings keep their standard
# NVD-derived remediation text and nothing breaks.
AI_REMEDIATION_API_KEY=
AI_REMEDIATION_ENABLED=true

SLACK_NOTIFICATIONS_ENABLED=true
SLACK_MIN_SEVERITY=critical

# --- Only if serving the frontend from this VM too ---------------------------
#
# Leave empty for a Vercel frontend. To use it: set the domain, uncomment the
# APP_DOMAIN block in the Caddyfile, and start with `--profile with-frontend`.
APP_DOMAIN=
